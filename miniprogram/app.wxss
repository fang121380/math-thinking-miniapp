page {
  min-height: 100%;
  background: #f9fcf8;
  color: #26342f;
  font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, image {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  line-height: 1;
}

.hint-button,
.feedback-action,
.reminder-band button,
.home-error button {
  justify-content: flex-start;
}

button::after {
  border: 0;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: calc(24rpx + env(safe-area-inset-top)) 40rpx calc(190rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.page.no-nav {
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 108rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark,
.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  background: #e7f2d5;
}

.icon {
  width: 36rpx;
  height: 36rpx;
}

.brand-name {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.brand-sub {
  display: block;
  color: #6c786f;
  font-size: 22rpx;
  line-height: 30rpx;
}

.status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 60rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #ffe3dd;
  color: #8b493c;
  font-size: 23rpx;
  font-weight: 700;
}

.status .icon {
  width: 30rpx;
  height: 30rpx;
}

.page-head {
  display: grid;
  grid-template-columns: 72rpx 1fr auto;
  align-items: center;
  min-height: 104rpx;
}

.page-head-title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #eef4ea;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: 100rpx;
  border-radius: 16rpx;
  background: #df6a51;
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
}

.primary-button .icon {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0) invert(1);
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border: 2rpx solid #bdcdb8;
  border-radius: 16rpx;
  background: #fff;
  color: #405545;
  font-size: 27rpx;
  font-weight: 700;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title-main {
  font-size: 36rpx;
  font-weight: 800;
}

.section-title-sub {
  color: #737d76;
  font-size: 23rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-muted {
  color: #6e796f;
}

.track {
  height: 14rpx;
  margin-top: 16rpx;
  background: #dce5da;
}

.track-fill {
  height: 100%;
  background: #7ea84e;
}

.question-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #587923;
  font-size: 24rpx;
  font-weight: 800;
}

.question-label .icon {
  width: 30rpx;
  height: 30rpx;
}

.question-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.45;
}

.question-help {
  display: block;
  margin-top: 8rpx;
  color: #6e786f;
  font-size: 25rpx;
  line-height: 1.6;
}

.panel {
  margin-top: 32rpx;
  padding: 34rpx;
  border: 2rpx solid #c5d2c1;
  border-radius: 16rpx;
  background: #fff;
}

.answer-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.answer-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  padding: 12rpx;
  border: 2rpx solid #c5d2c1;
  border-radius: 14rpx;
  background: #fff;
  color: #29382e;
  font-size: 30rpx;
  font-weight: 800;
}

.answer-button.selected {
  border-color: #df6a51;
  background: #fff1ed;
  color: #9e4939;
}

.hint-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 28rpx;
  color: #687469;
  font-size: 23rpx;
  line-height: 1.6;
}

.hint-row .icon {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  height: calc(164rpx + env(safe-area-inset-bottom));
  padding: 16rpx 18rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #dce5da;
  background: #fff;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #748078;
  font-size: 22rpx;
  font-weight: 700;
}

.nav-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 58rpx;
  border-radius: 14rpx;
}

.nav-item.active {
  color: #547a20;
}

.nav-item.active .nav-icon {
  background: #e7f2d5;
}

.nav-icon .icon {
  width: 36rpx;
  height: 36rpx;
}

.rabbit {
  object-fit: contain;
}

.empty-text {
  color: #758078;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}
