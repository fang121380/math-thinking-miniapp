<view class="page" style="padding-top: {{safeTop}}px;">
  <view class="topbar"><view class="brand"><view class="brand-mark"><image class="icon" src="/assets/icons/route.svg" mode="aspectFit" /></view><view><text class="brand-name">梵数学</text><text class="brand-sub">{{learningLabel}}</text></view></view><view class="status"><image class="icon" src="/assets/icons/calendar-check.svg" mode="aspectFit" /><text>本周 {{weeklyMission.completedDays}} / {{weeklyMission.targetDays}} 天</text></view></view>
  <view class="section-title growth-title"><text class="section-title-main">我的成长</text><text class="section-title-sub">本周进度</text></view>
  <view class="weekly-band">
    <view class="weekly-head"><view><text class="weekly-eyebrow">本周小目标</text><text class="weekly-title">完成 3 天学习</text></view><text class="weekly-count">{{weeklyMission.completedDays}} / {{weeklyMission.targetDays}} 天</text></view>
    <view class="weekly-track"><view class="weekly-fill" style="width: {{weeklyMission.progressPercent}}%"></view></view>
    <text class="weekly-copy">{{weeklyMission.nextCopy}}</text>
  </view>
  <view class="metric-grid" aria-label="我的学习收获"><view class="metric"><text>完成练习</text><text class="metric-value">{{progress.completedIds.length}} 题</text></view><view class="metric"><text>思维星</text><text class="metric-value">{{progress.stars}} 颗</text></view><view class="metric"><text>补会成功</text><text class="metric-value">{{recoveryWins}} 次</text></view></view>
  <view class="section-title journey-title"><text class="section-title-main">我的数学思路</text><text class="section-title-sub">每一类思路都会慢慢变熟</text></view>
  <view class="journey-list" aria-label="我的数学思路成长"><view wx:for="{{journeyRows}}" wx:key="key" class="journey-row"><view class="journey-copy-wrap"><text class="journey-name">{{item.label}}</text><text class="journey-copy">{{item.nextAction}}</text></view><view class="journey-meta"><text class="journey-state {{item.state}}">{{item.stateText}}</text><text class="journey-games" wx:if="{{item.gameCount}}">游戏 {{item.gameCount}} 局</text></view></view></view>
  <view class="section-title badges-title"><text class="section-title-main">思维徽章</text><text class="section-title-sub">每次认真思考都会留下记录</text></view>
  <view class="badge-list"><view wx:for="{{milestoneRows}}" wx:key="id" class="badge-row {{item.state}}"><view class="badge-icon"><image class="icon" src="/assets/icons/award.svg" mode="aspectFit" /></view><view class="badge-copy"><text class="badge-title">{{item.title}}</text><text class="badge-description">{{item.copy}}</text></view><text class="badge-state">{{item.stateText}}</text></view></view>
  <view class="ability-list"><view wx:for="{{abilityRows}}" wx:key="key" class="ability-row"><text>{{item.label}}</text><view class="ability-track"><view class="ability-fill" style="width: {{item.score}}%"></view></view><text>{{item.score}}</text></view></view>
  <view class="section-title mistakes-title"><text class="section-title-main">错题再练</text><text class="section-title-sub">{{mistakes.length}} 题待复习</text></view>
  <view wx:if="{{mistakes.length}}" class="mistake-list"><view wx:for="{{mistakes}}" wx:key="id" class="mistake-row" data-id="{{item.id}}" bindtap="viewAnalysis"><view class="mistake-icon"><image class="icon" src="/assets/icons/notebook-pen.svg" mode="aspectFit" /></view><view><text class="mistake-name">{{item.prompt}}</text><text class="mistake-copy">{{item.reason}}</text></view><text class="mistake-action">看分析</text></view></view>
  <view wx:else class="empty-box"><text class="empty-text">今天还没有错题，继续保持认真思考。</text></view>
  <view class="bottom-nav"><view class="nav-item" bindtap="goHome"><view class="nav-icon"><image class="icon" src="/assets/icons/house.svg" mode="aspectFit" /></view><text>今日</text></view><view class="nav-item" bindtap="goGames"><view class="nav-icon"><image class="icon" src="/assets/icons/gamepad-2.svg" mode="aspectFit" /></view><text>游戏</text></view><view class="nav-item active" bindtap="goGrowth"><view class="nav-icon"><image class="icon" src="/assets/icons/chart-no-axes-column-increasing.svg" mode="aspectFit" /></view><text>成长</text></view><view class="nav-item" bindtap="goMine"><view class="nav-icon"><image class="icon" src="/assets/icons/user-round.svg" mode="aspectFit" /></view><text>我的</text></view></view>
</view>
