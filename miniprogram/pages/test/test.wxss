.test-content {
  margin-top: 42rpx;
}

.input-wrap {
  padding: 36rpx 0;
}

.answer-input {
  width: 260rpx;
  height: 96rpx;
  margin: 0 auto;
  border: 4rpx solid #df6a51;
  border-radius: 14rpx;
  background: #fff8f5;
  color: #8b493c;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
}

.problem-input {
  width: 100%;
  height: 190rpx;
  padding: 20rpx;
  border: 2rpx solid #c5d2c1;
  border-radius: 14rpx;
  background: #fbfdfb;
  font-size: 28rpx;
  line-height: 1.6;
}

.hint-button {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
  background: transparent;
  color: #687469;
  font-size: 23rpx;
}

.hint-button .icon {
  width: 30rpx;
  height: 30rpx;
}

.submit-button {
  margin-top: 36rpx;
}
